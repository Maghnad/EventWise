# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eventwise

# ── OpenAI / GenAI ──────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ── Auth / JWT ──────────────────────────────────────────
# In production, JWT_SECRET must be at least 32 characters or startup will fail.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-32-char-key-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15

# ── App ─────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

